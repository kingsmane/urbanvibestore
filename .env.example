# Supabase (Project Settings -> API)
# URL proyek dan PUBLISHABLE key boleh dipakai di browser (akses dibatasi RLS).
# JANGAN pernah menaruh secret / service_role key di file ini atau di kode klien.
SUPABASE_PROJECT_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Alternatif nama (keduanya didukung):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
